---
import Layout from "../layouts/Layout.astro";
import { parks, company } from "../data/contacts";
---

<Layout
  title="Kontakt — AST Crane Slovakia"
  description="Kontaktné informácie 4 žeriavových parkov v Trenčíne, Dubnici, Trnave a Bratislave."
>
  <section class="bg-gradient-to-br from-brand-700 to-brand-500 text-white py-20">
    <div class="container-x">
      <div class="eyebrow text-brand-100 mb-3">Kontakt</div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">{company.name}</h1>
      <p class="text-lg text-brand-50 max-w-2xl">
        4 vlastné žeriavové parky, 16 kvalifikovaných žeriavnikov, 24/7 dispečing.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="grid md:grid-cols-2 gap-6">
        {parks.map((p) => (
          <div class="bg-white rounded-xl border border-slate-200 p-8">
            <div class="eyebrow mb-2">Žeriavový park</div>
            <h2 class="font-extrabold text-2xl mb-4">{p.city}</h2>
            <div class="text-sm text-slate-500 mb-4">{p.location}</div>

            <div class="space-y-3 border-t border-slate-100 pt-4">
              {p.people.map((person) => (
                <div>
                  <div class="font-semibold text-sm text-slate-700">{person.name}</div>
                  <a href={`tel:${person.phoneClean}`} class="text-lg font-bold text-brand-500 hover:underline">
                    {person.phone}
                  </a>
                </div>
              ))}
              <a href={`mailto:${p.email}`} class="block pt-2 text-sm text-brand-500 hover:underline">
                ✉ {p.email}
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-16 bg-brand-900 text-white rounded-2xl p-10 text-center">
        <h2 class="text-2xl md:text-3xl font-extrabold mb-3">Sledujte nás</h2>
        <p class="text-brand-100 mb-6">Aktuálne zákazky, fotky z práce a novinky.</p>
        <a href={company.facebook} target="_blank" rel="noopener" class="btn bg-white text-brand-700 hover:bg-brand-50">
          Facebook AST Crane →
        </a>
      </div>
    </div>
  </section>
</Layout>
