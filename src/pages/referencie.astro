---
import Layout from "../layouts/Layout.astro";
import { references } from "../data/content";
---

<Layout
  title="Referencie — AST Crane Slovakia"
  description="Stovky realizovaných montáží, presunov a búracích prác po celom Slovensku."
>
  <section class="bg-gradient-to-br from-brand-700 to-brand-500 text-white py-20">
    <div class="container-x">
      <div class="eyebrow text-brand-100 mb-3">Naša práca</div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">{references.title}</h1>
      <p class="text-lg text-brand-50 max-w-2xl">{references.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="bg-slate-50 rounded-xl p-10 text-center border-2 border-dashed border-slate-300">
        <div class="text-6xl mb-4">📸</div>
        <h2 class="text-2xl font-extrabold mb-3">Galéria sa pripravuje</h2>
        <p class="text-slate-600 max-w-xl mx-auto mb-6">
          {references.placeholderNote}
        </p>
        <p class="text-sm text-slate-500 max-w-xl mx-auto mb-6">
          Plánujeme automatický feed — žeriavnici nahrávajú fotky z práce priamo cez služobný mobil,
          fotky sa zobrazia ako case studies s mestom, dátumom, popisom stroja a práce.
        </p>
        <a href="/dopyt" class="btn-primary">Poslať dopyt</a>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mt-16">
        {["Stavebné montáže", "Priemyselné inštalácie", "Presuny strojov", "Búracie práce", "Reklamné panely", "Výkopy a zemné práce"].map((label) => (
          <div class="bg-white rounded-xl border border-slate-200 p-6">
            <div class="font-bold mb-2 text-brand-500">{label}</div>
            <p class="text-sm text-slate-600">Pravidelná súčasť našej práce po celom Slovensku.</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
