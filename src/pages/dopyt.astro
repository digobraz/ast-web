---
import Layout from "../layouts/Layout.astro";
import { parks } from "../data/contacts";
---

<Layout
  title="Dopyt — objednávka mechanizmu | AST Crane Slovakia"
  description="Nezáväzný dopyt na prenájom žeriavu, plošiny alebo ťahača. Odpovieme do 24 hodín."
>
  <section class="bg-gradient-to-br from-brand-700 to-brand-500 text-white py-20">
    <div class="container-x">
      <div class="eyebrow text-brand-100 mb-3">Kontakt</div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Nezáväzný dopyt</h1>
      <p class="text-lg text-brand-50 max-w-2xl">
        Vyplňte formulár alebo zavolajte priamo dispečerovi. Odpovieme spravidla do hodiny.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="grid lg:grid-cols-5 gap-10">
        <div class="lg:col-span-3">
          <form
            class="bg-white rounded-xl border border-slate-200 p-8 space-y-5"
            action="mailto:info@astcrane.sk"
            method="post"
            enctype="text/plain"
          >
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold mb-1">Meno *</label>
                <input name="meno" required type="text" class="w-full px-4 py-3 rounded-md border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
              </div>
              <div>
                <label class="block text-sm font-semibold mb-1">Firma</label>
                <input name="firma" type="text" class="w-full px-4 py-3 rounded-md border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-semibold mb-1">Telefón *</label>
                <input name="telefon" required type="tel" class="w-full px-4 py-3 rounded-md border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
              </div>
              <div>
                <label class="block text-sm font-semibold mb-1">E-mail *</label>
                <input name="email" required type="email" class="w-full px-4 py-3 rounded-md border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold mb-1">Mesto / lokalita</label>
              <input name="mesto" type="text" class="w-full px-4 py-3 rounded-md border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none" placeholder="Trenčín, Bratislava…" />
            </div>

            <div>
              <label class="block text-sm font-semibold mb-1">Popis práce *</label>
              <textarea name="popis" required rows="6" class="w-full px-4 py-3 rounded-md border border-slate-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none resize-none" placeholder="Stručne popíšte čo potrebujete — typ práce, dátum, nosnosť, výška…"></textarea>
            </div>

            <label class="flex items-start gap-3 text-sm text-slate-600">
              <input type="checkbox" required class="mt-1" />
              <span>Súhlasím so spracovaním osobných údajov za účelom vybavenia dopytu.</span>
            </label>

            <button type="submit" class="btn-primary w-full">Odoslať dopyt →</button>
          </form>

          <p class="text-xs text-slate-500 mt-4">
            * povinné polia. Formulár momentálne otvorí váš e-mailový klient.
            Plné odoslanie cez backend (Formspree / Resend) pridáme po nasadení na ostrú doménu.
          </p>
        </div>

        <aside class="lg:col-span-2 space-y-4">
          <div class="bg-brand-50 rounded-xl p-6 border border-brand-100">
            <h3 class="font-extrabold text-lg mb-4">Volajte priamo dispečerovi</h3>
            {parks.slice(0, 3).map((p) => (
              <div class="mb-4 last:mb-0">
                <div class="text-xs uppercase tracking-wide text-brand-500 font-semibold mb-1">{p.city}</div>
                {p.people.map((person) => (
                  <a href={`tel:${person.phoneClean}`} class="block text-base font-bold text-slate-900 hover:text-brand-500">
                    {person.phone} <span class="font-normal text-sm text-slate-600">— {person.name}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>

          <div class="bg-slate-100 rounded-xl p-6">
            <div class="text-sm text-slate-700">
              <strong>24/7 dispečing</strong> — v súrnych prípadoch sme k dispozícii aj v noci.
              Stačí zavolať najbližšiemu parku.
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
