---
import Layout from "../layouts/Layout.astro";
import { hero, services } from "../data/content";
import { cranes, stats } from "../data/cranes";
import { parks } from "../data/contacts";

const featured = cranes.slice(0, 6);
const topStats = stats.slice(0, 3);
---

<Layout>
  <section class="relative text-white overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/img/hero/slide1.jpg');"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-brand-900/85 via-brand-700/75 to-brand-500/60"></div>
    <div class="container-x relative py-20 md:py-32">
      <div class="max-w-3xl">
        <div class="text-sm uppercase tracking-widest text-brand-100 mb-4 font-semibold">{hero.eyebrow}</div>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">{hero.title}</h1>
        <p class="text-lg md:text-xl text-brand-50 mb-8 max-w-2xl">{hero.subtitle}</p>
        <div class="flex flex-wrap gap-3">
          <a href={hero.ctaPrimary.href} class="btn bg-white text-brand-700 hover:bg-brand-50 px-7 py-4 text-base">
            {hero.ctaPrimary.label} →
          </a>
          <a href={hero.ctaSecondary.href} class="btn border-2 border-white/40 text-white hover:bg-white/10 px-7 py-4 text-base">
            {hero.ctaSecondary.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container-x">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {topStats.map((s) => (
          <div class="bg-white rounded-xl p-8 text-center shadow-sm border border-slate-100">
            <div class="text-5xl font-extrabold text-brand-500 mb-2">{s.value}</div>
            <div class="text-lg font-bold mb-2">{s.label}</div>
            <p class="text-sm text-slate-600">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="text-center mb-12">
        <div class="eyebrow mb-2">Čo ponúkame</div>
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Komplexné riešenie pre vaše stavby</h2>
        <p class="text-slate-600 max-w-2xl mx-auto">
          Žeriavy, plošiny, ťahače aj búracie stroje — všetko z jednej ruky, so skúsenou obsluhou.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {services.map((s) => (
          <a href={s.href} class="group block p-6 bg-white rounded-xl border border-slate-200 hover:border-brand-500 hover:shadow-lg transition-all">
            <div class="w-12 h-12 rounded-lg bg-brand-50 flex items-center justify-center text-2xl mb-4 group-hover:bg-brand-500 group-hover:text-white transition-colors">
              {s.icon === "crane" && "🏗️"}
              {s.icon === "platform" && "⬆️"}
              {s.icon === "truck" && "🚚"}
              {s.icon === "excavator" && "⛏️"}
            </div>
            <h3 class="font-bold text-lg mb-2 group-hover:text-brand-500">{s.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{s.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container-x">
      <div class="flex items-end justify-between mb-12">
        <div>
          <div class="eyebrow mb-2">Náš park</div>
          <h2 class="text-3xl md:text-4xl font-extrabold">Žeriavy až do 100 ton</h2>
        </div>
        <a href="/zeriavy" class="hidden md:inline-flex btn-ghost">Všetky stroje →</a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featured.map((c) => (
          <a href={`/zeriavy#${c.slug}`} class="group block bg-white rounded-xl overflow-hidden border border-slate-200 hover:shadow-lg transition-all">
            <div class="aspect-video bg-slate-200 overflow-hidden">
              <img src={c.image} alt={c.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-5">
              <div class="text-xs text-brand-500 font-semibold mb-1">{c.capacity} max nosnosť</div>
              <h3 class="font-bold text-lg mb-2 group-hover:text-brand-500">{c.name}</h3>
              <p class="text-sm text-slate-600 line-clamp-2">{c.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center md:hidden">
        <a href="/zeriavy" class="btn-primary">Pozrieť všetky stroje</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="bg-brand-900 rounded-2xl p-10 md:p-16 text-white text-center">
        <h2 class="text-3xl md:text-4xl font-extrabold mb-4">Neviete aký žeriav potrebujete?</h2>
        <p class="text-brand-100 mb-8 max-w-2xl mx-auto">
          Zavolajte nášmu dispečerovi — bezplatne poradíme, aký stroj zvolíme pre vašu prácu.
          K dispozícii sme 24/7.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/dopyt" class="btn bg-white text-brand-700 hover:bg-brand-50 px-7 py-4">Poslať dopyt →</a>
          <a href="tel:+421903439157" class="btn border-2 border-white/40 hover:bg-white/10 px-7 py-4">📞 0903 439 157</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container-x">
      <div class="text-center mb-12">
        <div class="eyebrow mb-2">Pokrytie</div>
        <h2 class="text-3xl md:text-4xl font-extrabold">4 vlastné žeriavové parky</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {parks.map((p) => (
          <div class="bg-white rounded-xl p-6 border border-slate-200 text-center">
            <div class="font-extrabold text-xl text-brand-500 mb-1">{p.city}</div>
            <div class="text-xs text-slate-500 mb-4">{p.location}</div>
            <a href={`mailto:${p.email}`} class="text-xs text-brand-500 hover:underline">
              {p.email}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
